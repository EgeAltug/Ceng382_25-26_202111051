@page
@model IndexModel

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col">
            <form method="get" class="form-inline">
                <div class="input-group">
                    <input type="text" name="FilterClassName" value="@Model.FilterClassName" class="form-control" placeholder="Filter by Class Name" />
                    <button type="submit" class="btn btn-outline-primary">Filter</button>
                </div>
            </form>
        </div>
    </div>

    <div class="row">
        <!-- Form Section (unchanged) -->
        <!-- ... keep your existing form here ... -->
    </div>

    <div class="row mt-4">
        <div class="col">
            <div class="card">
                <div class="card-header">Class List</div>
                <div class="card-body">
                    @if (!Model.PaginatedClasses.Any())
                    {
                        <p>No classes found</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Class Name</th>
                                        <th>Students</th>
                                        <th>Description</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.PaginatedClasses)
                                    {
                                        <tr>
                                            <td>@item.ClassName</td>
                                            <td>@item.StudentCount</td>
                                            <td>@item.Description</td>
                                            <td>
                                                <form method="post" asp-page-handler="Edit" asp-route-id="@item.Id" class="d-inline">
                                                    <button class="btn btn-sm btn-warning">Edit</button>
                                                </form>
                                                <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" class="d-inline">
                                                    <button class="btn btn-sm btn-danger" onclick="return confirm('Are you sure?')">Delete</button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Pagination -->
                        <nav>
                            <ul class="pagination">
                                @for (int i = 1; i <= Model.TotalPages; i++)
                                {
                                    <li class="page-item @(Model.PageNumber == i ? "active" : "")">
                                        <a class="page-link" asp-page="./Index" asp-route-FilterClassName="@Model.FilterClassName" asp-route-PageNumber="@i">@i</a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
