@page
@model IndexModel

<div class="container mt-4">
    <!-- Filter Section -->
    <form method="get" class="mb-4 border p-3 rounded">
        <div class="row g-3">
            <div class="col-md-4">
                <input asp-for="TableData.ClassNameFilter" 
                       class="form-control" 
                       placeholder="Search by class name">
            </div>
            <div class="col-md-4">
                <input asp-for="TableData.DescriptionFilter" 
                       class="form-control" 
                       placeholder="Search by description">
            </div>
            <div class="col-md-2">
                <select asp-for="TableData.PageSize" class="form-select"
                        asp-items="new SelectList(new[] { 5, 10, 20, 50 })">
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-funnel"></i> Filter
                </button>
            </div>
        </div>
    </form>

    <div class="row">
        <!-- Add/Edit Form (Left Column) -->
        <div class="col-md-5">
            <div class="card mb-4">
                <div class="card-header">
                    @(Model.EditId.HasValue ? "Edit Class" : "Add New Class")
                </div>
                <div class="card-body">
                    <form method="post" asp-page-handler="@(Model.EditId.HasValue ? "Update" : "Add")">
                        <input type="hidden" asp-for="Input.Id" />
                        <div class="mb-3">
                            <label asp-for="Input.ClassName" class="form-label"></label>
                            <input asp-for="Input.ClassName" class="form-control">
                            <span asp-validation-for="Input.ClassName" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Input.StudentCount" class="form-label"></label>
                            <input asp-for="Input.StudentCount" class="form-control">
                            <span asp-validation-for="Input.StudentCount" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Input.Description" class="form-label"></label>
                            <textarea asp-for="Input.Description" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Input.Description" class="text-danger"></span>
                        </div>
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary">
                                @(Model.EditId.HasValue ? "Update" : "Create")
                            </button>
                            @if (Model.EditId.HasValue)
                            {
                                <a asp-page="./Index" class="btn btn-outline-secondary">Cancel</a>
                            }
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Data Table (Right Column) -->
        <div class="col-md-7">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>Class List</span>
                    <div class="text-muted">
                        Page @Model.TableData.CurrentPage of @Model.TableData.TotalPages
                    </div>
                </div>
                
                <div class="card-body">
                    @if (!Model.TableData.Items.Any())
                    {
                        <div class="alert alert-info">No classes found matching your filters</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Class Name</th>
                                        <th>Students</th>
                                        <th>Description</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.TableData.Items)
                                    {
                                        <tr>
                                            <td>@item.ClassName</td>
                                            <td>@item.StudentCount</td>
                                            <td>@item.Description</td>
                                            <td>
                                                <form method="post" class="d-inline">
                                                    <button asp-page-handler="Edit" 
                                                            asp-route-id="@item.Id"
                                                            class="btn btn-sm btn-warning">
                                                        Edit
                                                    </button>
                                                </form>
                                                <form method="post" class="d-inline">
                                                    <button asp-page-handler="Delete" 
                                                            asp-route-id="@item.Id"
                                                            class="btn btn-sm btn-danger"
                                                            onclick="return confirm('Delete this class?')">
                                                        Delete
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

                <!-- Pagination -->
                @if (Model.TableData.TotalPages > 1)
                {
                    <div class="card-footer">
                        <nav aria-label="Page navigation">
                            <ul class="pagination justify-content-center mb-0">
                                <li class="page-item @(Model.TableData.CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" 
                                       asp-route-currentpage="@(Model.TableData.CurrentPage - 1)"
                                       asp-all-route-data="@GetRouteData()">
                                        Previous
                                    </a>
                                </li>
                                
                                @for (int i = 1; i <= Model.TableData.TotalPages; i++)
                                {
                                    <li class="page-item @(i == Model.TableData.CurrentPage ? "active" : "")">
                                        <a class="page-link" 
                                           asp-route-currentpage="@i"
                                           asp-all-route-data="@GetRouteData()">
                                            @i
                                        </a>
                                    </li>
                                }
                                
                                <li class="page-item @(Model.TableData.CurrentPage >= Model.TableData.TotalPages ? "disabled" : "")">
                                    <a class="page-link" 
                                       asp-route-currentpage="@(Model.TableData.CurrentPage + 1)"
                                       asp-all-route-data="@GetRouteData()">
                                        Next
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@functions {
    private Dictionary<string, string> GetRouteData()
    {
        return new Dictionary<string, string>
        {
            { "classnamefilter", Model.TableData.ClassNameFilter ?? "" },
            { "descriptionfilter", Model.TableData.DescriptionFilter ?? "" },
            { "pagesize", Model.TableData.PageSize.ToString() }
        };
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}