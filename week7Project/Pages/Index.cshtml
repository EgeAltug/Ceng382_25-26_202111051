@page
@model IndexModel

<div class="container mt-4">
    <!-- Filter Form and Export Buttons -->
    <div class="row mb-3">
        <div class="col-md-6">
            <form method="get" class="form-inline">
                <div class="input-group">
                    <input type="text" name="FilterClassName" value="@Model.FilterClassName" class="form-control" placeholder="Filter by Class Name" />
                    <button type="submit" class="btn btn-outline-primary">Filter</button>
                </div>
            </form>
        </div>
        <div class="col-md-6 text-end">
            <div class="btn-group">
                <button type="button" class="btn btn-success" onclick="handleExport('unfiltered')">
                    Export Full Data
                </button>
                <button type="button" class="btn btn-info" onclick="handleExport('filtered')">
                    Export Filtered Data
                </button>
            </div>
            <form id="exportForm" method="post" asp-page-handler="Export" class="d-none">
                <input type="hidden" name="ExportType" id="exportType" />
                <input type="hidden" name="SelectedColumns" id="selectedColumns" />
            </form>
        </div>
    </div>

    <!-- Add/Edit Form -->
    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    @(Model.EditId.HasValue ? "Edit Class" : "Add New Class")
                </div>
                <div class="card-body">
                    <form method="post" asp-page-handler="@(Model.EditId.HasValue ? "Update" : "Add")">
                        <input type="hidden" asp-for="Input.Id" />
                        <div class="form-group mb-3">
                            <label asp-for="Input.ClassName" class="form-label"></label>
                            <input asp-for="Input.ClassName" class="form-control" />
                            <span asp-validation-for="Input.ClassName" class="text-danger"></span>
                        </div>
                        <div class="form-group mb-3">
                            <label asp-for="Input.StudentCount" class="form-label"></label>
                            <input asp-for="Input.StudentCount" class="form-control" />
                            <span asp-validation-for="Input.StudentCount" class="text-danger"></span>
                        </div>
                        <div class="form-group mb-3">
                            <label asp-for="Input.Description" class="form-label"></label>
                            <textarea asp-for="Input.Description" class="form-control"></textarea>
                            <span asp-validation-for="Input.Description" class="text-danger"></span>
                        </div>
                        <button type="submit" class="btn btn-primary">
                            @(Model.EditId.HasValue ? "Update" : "Add")
                        </button>
                        @if (Model.EditId.HasValue)
                        {
                            <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
                        }
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Class Table and Pagination -->
    <div class="row mt-4">
        <div class="col">
            <div class="card">
                <div class="card-header">Class List</div>
                <div class="card-body">
                    @if (!Model.PaginatedClasses.Any())
                    {
                        <p>No classes found</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th data-exportable="true">Class Name</th>
                                        <th data-exportable="true">Students</th>
                                        <th data-exportable="true">Description</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.PaginatedClasses)
                                    {
                                        <tr>
                                            <td>@item.ClassName</td>
                                            <td>@item.StudentCount</td>
                                            <td>@item.Description</td>
                                            <td>
                                                <form method="post" asp-page-handler="Edit" asp-route-id="@item.Id" class="d-inline">
                                                    <button class="btn btn-sm btn-warning">Edit</button>
                                                </form>
                                                <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" class="d-inline">
                                                    <button class="btn btn-sm btn-danger" onclick="return confirm('Are you sure?')">Delete</button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Pagination Controls -->
                        <nav>
                            <ul class="pagination">
                                @for (int i = 1; i <= Model.TotalPages; i++)
                                {
                                    <li class="page-item @(Model.PageNumber == i ? "active" : "")">
                                        <a class="page-link" asp-page="./Index" asp-route-FilterClassName="@Model.FilterClassName" asp-route-PageNumber="@i">@i</a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let selectedColumns = new Set();
        
        document.querySelectorAll('th[data-exportable]').forEach((th, index) => {
            th.style.cursor = 'pointer';
            th.addEventListener('click', () => {
                th.classList.toggle('bg-primary');
                th.classList.toggle('text-white');
                
                if (selectedColumns.has(index)) {
                    selectedColumns.delete(index);
                } else {
                    selectedColumns.add(index);
                }
                
                document.getElementById('selectedColumns').value = 
                    Array.from(selectedColumns).join(',');
            });
        });

        function handleExport(type) {
            document.getElementById('exportType').value = type;
            document.getElementById('exportForm').submit();
        }
    </script>
}