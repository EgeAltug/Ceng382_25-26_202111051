@page
@model IndexModel

<div class="container mt-4">
    <!-- Filter Form -->
    <div class="row mb-3">
        <div class="col">
            <form method="get" class="form-inline">
                <div class="input-group">
                    <input type="text" name="FilterClassName" value="@Model.FilterClassName" class="form-control" placeholder="Filter by Class Name" />
                    <button type="submit" class="btn btn-outline-primary">Filter</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Add/Edit Form -->
    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    @(Model.EditId.HasValue ? "Edit Class" : "Add New Class")
                </div>
                <div class="card-body">
                    <form method="post" asp-page-handler="@(Model.EditId.HasValue ? "Update" : "Add")">
                        <input type="hidden" asp-for="Input.Id" />
                        <div class="form-group mb-3">
                            <label asp-for="Input.ClassName" class="form-label"></label>
                            <input asp-for="Input.ClassName" class="form-control" />
                            <span asp-validation-for="Input.ClassName" class="text-danger"></span>
                        </div>
                        <div class="form-group mb-3">
                            <label asp-for="Input.StudentCount" class="form-label"></label>
                            <input asp-for="Input.StudentCount" class="form-control" />
                            <span asp-validation-for="Input.StudentCount" class="text-danger"></span>
                        </div>
                        <div class="form-group mb-3">
                            <label asp-for="Input.Description" class="form-label"></label>
                            <textarea asp-for="Input.Description" class="form-control"></textarea>
                            <span asp-validation-for="Input.Description" class="text-danger"></span>
                        </div>
                        <button type="submit" class="btn btn-primary">
                            @(Model.EditId.HasValue ? "Update" : "Add")
                        </button>
                        @if (Model.EditId.HasValue)
                        {
                            <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
                        }
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Export Options -->
    <div class="row mt-4">
        <div class="col">
            <div class="card">
                <div class="card-header">Export Options</div>
                <div class="card-body">
                    <!-- Form for JSON export -->
                    <form method="post" asp-page-handler="Export">
                        <!-- Export mode selection: using a hidden input to decide mode on button click -->
                        <input type="hidden" id="ExportMode" name="ExportMode" value="" />

                        <!-- Column Selection -->
                        <div class="mb-3">
                            <label>Select Columns to Export:</label><br />
                            <label class="btn btn-outline-secondary m-1">
                                <input type="checkbox" name="SelectedColumns" value="ClassName" autocomplete="off" /> Class Name
                            </label>
                            <label class="btn btn-outline-secondary m-1">
                                <input type="checkbox" name="SelectedColumns" value="StudentCount" autocomplete="off" /> Student Count
                            </label>
                            <label class="btn btn-outline-secondary m-1">
                                <input type="checkbox" name="SelectedColumns" value="Description" autocomplete="off" /> Description
                            </label>
                        </div>

                        <!-- Export Buttons -->
                        <button type="submit" class="btn btn-info" onclick="document.getElementById('ExportMode').value = 'unfiltered';">
                            Export All (Unfiltered)
                        </button>
                        <button type="submit" class="btn btn-info" onclick="document.getElementById('ExportMode').value = 'filtered';">
                            Export Filtered
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Class Table and Pagination -->
    <div class="row mt-4">
        <div class="col">
            <div class="card">
                <div class="card-header">Class List</div>
                <div class="card-body">
                    @if (!Model.PaginatedClasses.Any())
                    {
                        <p>No classes found</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Class Name</th>
                                        <th>Students</th>
                                        <th>Description</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.PaginatedClasses)
                                    {
                                        <tr>
                                            <td>@item.ClassName</td>
                                            <td>@item.StudentCount</td>
                                            <td>@item.Description</td>
                                            <td>
                                                <form method="post" asp-page-handler="Edit" asp-route-id="@item.Id" class="d-inline">
                                                    <button class="btn btn-sm btn-warning">Edit</button>
                                                </form>
                                                <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" class="d-inline">
                                                    <button class="btn btn-sm btn-danger" onclick="return confirm('Are you sure?')">Delete</button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Pagination Controls -->
                        <nav>
                            <ul class="pagination">
                                @for (int i = 1; i <= Model.TotalPages; i++)
                                {
                                    <li class="page-item @(Model.PageNumber == i ? "active" : "")">
                                        <a class="page-link" asp-page="./Index" asp-route-FilterClassName="@Model.FilterClassName" asp-route-PageNumber="@i">@i</a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Simple script to toggle the button style on checkbox selection.
        document.querySelectorAll('input[type="checkbox"][name="SelectedColumns"]').forEach(function(checkbox) {
            checkbox.addEventListener('change', function () {
                if (this.checked) {
                    this.parentElement.classList.remove('btn-outline-secondary');
                    this.parentElement.classList.add('btn-success');
                } else {
                    this.parentElement.classList.remove('btn-success');
                    this.parentElement.classList.add('btn-outline-secondary');
                }
            });
        });
    </script>
}
