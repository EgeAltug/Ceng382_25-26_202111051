@page
@model week5Project.Pages.IndexModel
@{
    ViewData["Title"] = "Class Information";
}

<div class="container mt-5">
    <div class="row">
        <!-- Form on the left side -->
        <div class="col-md-6">
            <h2>Add / Edit Class</h2>

            <form method="post">
                <div class="mb-3">
                    <label for="ClassName" class="form-label">Class Name</label>
                    <input type="text" class="form-control" id="ClassName" name="ClassInfo.ClassName" value="@Model.ClassInfo.ClassName" required />
                </div>
                <div class="mb-3">
                    <label for="StudentCount" class="form-label">Student Count</label>
                    <input type="number" class="form-control" id="StudentCount" name="ClassInfo.StudentCount" value="@Model.ClassInfo.StudentCount" required />
                </div>
                <div class="mb-3">
                    <label for="Description" class="form-label">Description</label>
                    <textarea class="form-control" id="Description" name="ClassInfo.Description" required>@Model.ClassInfo.Description</textarea>
                </div>

                <button type="submit" class="btn btn-primary" asp-page-handler="Add">Add Class</button>

                @if (Model.ClassInfo.Id != 0)
                {
                    <button type="submit" class="btn btn-success" asp-page-handler="Update">Update Class</button>
                }
            </form>
        </div>

        <!-- Table on the right side -->
        <div class="col-md-6">
            <h2>Class List</h2>
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Class Name</th>
                        <th>Student Count</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var classInfo in Model.Classes)
                    {
                        <tr>
                            <td>@classInfo.Id</td>
                            <td>@classInfo.ClassName</td>
                            <td>@classInfo.StudentCount</td>
                            <td>@classInfo.Description</td>
                            <td>
                                <form method="post" style="display:inline;">
                                    <button type="submit" class="btn btn-warning btn-sm" asp-page-handler="Edit" asp-route-id="@classInfo.Id">Edit</button>
                                </form>
                                <form method="post" style="display:inline;">
                                    <button type="submit" class="btn btn-danger btn-sm" asp-page-handler="Delete" asp-route-id="@classInfo.Id">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
